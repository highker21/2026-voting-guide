%3d%3d","accessed":"2026-10-09"}},"towns":["桃園區","中壢區","大溪區","楊梅區","蘆竹區","大園區","龜山區","八德區","龍潭區","平鎮區","新屋區","觀音區","復興區"],"races":[{"id":"mayor","type":"直轄市長","name":"桃園市長","area":"全市","seats":1,"note":"","candidates":[{"id":"mayor-1","name":"張善政","party":"中國國民黨","number":null,"incumbent":true,"bio":[{"text":"美國康乃爾大學土木工程博士","src":["B1"]},{"text":"美國史丹福大學土木工程碩士","src":["B1"]},{"text":"國立臺灣大學土木工程學系講師、副教授、教授","src":["B1"]},{"text":"行政院國家科學委員會國家高速電腦中心主任","src":["B1"]},{"text":"美商Google公司亞洲硬體營運總監","src":["B1"]},{"text":"行政院政務委員、科技部部長、行政院副院長、行政院院長","src":["B1"]}],"record":[{"text":"截至115年1月，桃園市長期債務未償餘額350億元、短期債務未償餘額50億元，合計400億元，施政報告列人均負債1.7萬元。","src":["M1"],"label":"縣市府自述（施政報告／新聞稿）"},{"text":"桃園市社會住宅已完工14處（4,374戶）、興建中7處（1,631戶）、設計及規劃中17處（5,130戶），市府目標為119年社宅總數達1萬戶。","src":["M2"],"label":"縣市府自述（施政報告／新聞稿）"},{"text":"截至115年1月底，桃園市共設置56家公共托育設施（38家公設民營托嬰中心、18家社區公共托育家園），可收托1,808名兒童。","src":["M3"],"label":"縣市府自述（施政報告／新聞稿）"},{"text":"施政報告載明，捷運綠線以115年第一階段北段7座車站通車為目標，棕線已於115年1月7日完成工程經費審議，綠線延伸中壢計畫辦理招標中。","src":["M4"],"label":"縣市府自述（施政報告／新聞稿）"},{"text":"114年9月1日至115年1月31日，桃園市育兒津貼受益11萬3,336人次、補助6億4,297萬500元；同期生育津貼補助5,438名新生兒、撥付1億9,311萬元。","src":["M5"],"label":"縣市府自述（施政報告／新聞稿）"},{"text":"監察院財政及經濟委員會於112年10月4日決議糾正桃園市政府（及農業部），案由為112年3月27日圍捕保育類東非狒狒時未指派指揮官、獵人持槍射擊致狒狒死亡。","src":["M6"]}],"platform":[],"donation_2022":null,"reg":{"date":"115/09/01","page":1,"src":["R11"]}},{"id":"mayor-2","name":"黃世杰","party":"民主進步黨","number":null,"incumbent":false,"bio":[{"text":"美國哥倫比亞大學法學碩士","src":["B2"]},{"text":"臺灣大學法學碩士","src":["B2"]},{"text":"臺灣大學法律、社會雙學士","src":["B2"]},{"text":"立法院司法及法制委員會召集委員","src":["B2"]},{"text":"立法院民主進步黨黨團副幹事長、副書記長","src":["B2"]},{"text":"桃園市政府參議、顧問","src":["B2"]}],"record":[],"platform":[],"donation_2022":null,"reg":{"date":"115/09/02","page":1,"src":["R11"]}}]},{"id":"council-1","type":"議員","name":"桃園市議員 第1選舉區","indigenous":null,"area":"桃園區","seats":12,"districts":["桃園區"],"note":"婦女保障至少 3 席。","candidates":[{"id":"council-1-1","name":"黃婉如","party":"中國國民黨","number":null,"incumbent"